<Window x:Class="FramePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FramePilot.App.ViewModels"
        xmlns:v="clr-namespace:FramePilot.App.Views"
        xmlns:l="clr-namespace:FramePilot.App.Localization"
        Title="TuneFPS" Width="1320" Height="860" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{DynamicResource UiFont}" Icon="Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><v:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><v:HardwareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><v:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}"><v:SessionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecommendationsViewModel}"><v:RecommendationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecoveryViewModel}"><v:RecoveryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComputerPage}">
            <StackPanel>
                <ContentControl Content="{Binding Hardware}" Focusable="False" />
                <ContentControl Content="{Binding Games}" Focusable="False" Margin="0,24,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangesPage}">
            <StackPanel>
                <ContentControl Content="{Binding History}" Focusable="False" />
                <ContentControl Content="{Binding Recovery}" Focusable="False" Margin="0,24,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <Image DockPanel.Dock="Top" Source="Assets/logo-wordmark.png" Height="26" HorizontalAlignment="Left"
                       Margin="10,2,0,24" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="TuneFPS" />
                <StackPanel DockPanel.Dock="Bottom" Margin="10,12,0,0">
                    <Border Height="1" Background="{StaticResource Line}" Margin="-10,0,0,12" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                               Text="{Binding Settings.LicenseStatusText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                        <Run Text="TuneFPS " /><Run Text="{Binding Settings.Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Nav}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"
                                         AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Demo flag: dashed amber outline, as in the brand book (tf-demo-flag) -->
            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1" Padding="32,8"
                    Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Border BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="DEMO" Foreground="{StaticResource Warn}" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <TextBlock Foreground="{StaticResource Warn}" Text="{l:T Demo_Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding Workspace.Busy, Converter={StaticResource BoolVis}}" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl Content="{Binding CurrentPage}" Margin="32,24,32,32" MaxWidth="1240" HorizontalAlignment="Stretch" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
