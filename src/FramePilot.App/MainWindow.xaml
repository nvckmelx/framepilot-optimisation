<Window x:Class="FramePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FramePilot.App.ViewModels"
        xmlns:v="clr-namespace:FramePilot.App.Views"
        xmlns:l="clr-namespace:FramePilot.App.Localization"
        Title="FRAMEPILOT" Width="1320" Height="860" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" Icon="Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><v:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><v:HardwareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}"><v:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}"><v:SessionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecommendationsViewModel}"><v:RecommendationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecoveryViewModel}"><v:RecoveryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,18">
                <Image DockPanel.Dock="Top" Source="Assets/logo-wordmark.png" Height="36" HorizontalAlignment="Left"
                       Margin="4,0,0,28" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="FRAMEPILOT" />
                <StackPanel DockPanel.Dock="Bottom" Margin="8,12,0,0">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                               Text="{Binding Settings.LicenseStatusText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                        <Run Text="v" /><Run Text="{Binding Settings.Version, Mode=OneWay}" /><Run Text=" · local-first" />
                    </TextBlock>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Nav}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"
                                         AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Icon}" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Warn}" Padding="24,9"
                    Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
                <TextBlock Foreground="{StaticResource Bg}" FontWeight="Bold" Text="{l:T Demo_Banner}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding Workspace.Busy, Converter={StaticResource BoolVis}}" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl Content="{Binding CurrentPage}" Margin="40,32,40,40" MaxWidth="1180" HorizontalAlignment="Stretch" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
