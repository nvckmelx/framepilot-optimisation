<UserControl x:Class="FramePilot.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FramePilot.App.Localization"
             xmlns:c="clr-namespace:FramePilot.App.Controls">
    <UserControl.Resources>
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="SegmentItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="8" Padding="12,7" Margin="0,0,6,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Nav_Sessions}" />
        <TextBlock Style="{StaticResource H1}" Text="{l:T Sessions_Title}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Sessions_Sub}" Margin="0,0,0,24" MaxWidth="760" HorizontalAlignment="Left" />

        <!-- Capture -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4">
                    <Run Text="{l:T Sessions_Capture}" /><Run Text=" · " /><Run Text="{Binding GameName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T Sessions_CaptureHint}" Margin="0,0,0,16" />

                <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding PresentMonMissing, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="{l:T Capture_NoPresentMon}" />
                </Border>

                <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Sessions_Duration}" />
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding Seconds, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SegmentItem}" Margin="0,0,0,10">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource Text}"><Run Text="{Binding Mode=OneWay}" /><Run Text=" s" /></TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Sessions_Group}" />
                <WrapPanel Margin="0,0,0,10">
                    <RadioButton Style="{StaticResource Segment}" GroupName="grp" Content="{l:T Group_Baseline}" IsChecked="{Binding IsBaseline, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="grp" Content="{l:T Group_After}" IsChecked="{Binding IsAfter, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="grp" Content="{l:T Group_Unlabeled}" IsChecked="{Binding IsUnlabeled, Mode=TwoWay}" />
                </WrapPanel>

                <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Sessions_Note}" />
                <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="620" HorizontalAlignment="Left" Width="620" Margin="0,0,0,18" />

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Content="{l:T Sessions_Start}" />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Content="{l:T Sessions_Stop}" />
                    <Button Command="{Binding ImportCommand}" Content="{l:T Sessions_Import}" />
                </StackPanel>
                <ProgressBar Margin="0,16,0,6" Value="{Binding CaptureProgress, Mode=OneWay}" Maximum="100"
                             Visibility="{Binding Capturing, Converter={StaticResource BoolVis}}" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding CaptureStatus}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Comparison -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasComparison, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Sessions_Comparison}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ComparisonSummary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ComparisonWarnings}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource Warn}" Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding ComparisonRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Name}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Value}" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Hint}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T Sessions_CompareRule}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Session list -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{l:T Sessions_List}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{l:T Sessions_Empty}"
                               Visibility="{Binding Items.Count, Converter={StaticResource CountVis}, ConverterParameter=inv}" />
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource RowItem}" MaxHeight="560">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding GroupText}"
                                                ToolTip="{l:T Sessions_GroupTip}"
                                                Command="{Binding DataContext.SetGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource MutedText}">
                                        <Run Text="{Binding Fps, Mode=OneWay}" /><Run Text=" FPS · P99 " /><Run Text="{Binding P99, Mode=OneWay}" /><Run Text=" ms · 1% low " /><Run Text="{Binding Low1, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Spikes, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Selected session -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{Binding Selected.Title}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource MutedText}" Text="{l:T Sessions_SelectHint}"
                               Visibility="{Binding HasSelection, Converter={StaticResource InvBoolVis}}" />
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Sessions_ChartTitle}" />
                        <c:FrameTimeChart Frames="{Binding Frames}" Height="240" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7" ToolTip="{Binding Hint}" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SelectedWarnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding StringFormat='• {0}'}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Command="{Binding OpenCsvCommand}" Content="{l:T Sessions_OpenCsv}" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Content="{l:T Delete}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
