<UserControl x:Class="FramePilot.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FramePilot.App.Localization">
    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Nav_Games}" />
        <TextBlock Style="{StaticResource H1}" Text="{l:T Games_Title}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Games_Sub}" Margin="0,0,0,18" MaxWidth="760" HorizontalAlignment="Left" />
        <Button HorizontalAlignment="Left" Command="{Binding RescanCommand}" Content="{l:T Games_Rescan}" Margin="0,0,0,18" />
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{l:T Games_OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Games_Select}" Command="{Binding SelectCommand}" Margin="0"
                                            Visibility="{Binding IsTarget, Converter={StaticResource InvBoolVis}}" />
                                    <Border Style="{StaticResource Chip}" BorderBrush="{StaticResource Accent}" VerticalAlignment="Center" Margin="0"
                                            Visibility="{Binding IsTarget, Converter={StaticResource BoolVis}}">
                                        <TextBlock Foreground="{StaticResource Accent}" Text="{l:T Games_Selected}" FontSize="12" />
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding State}" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8" ToolTip="{Binding Tooltip}" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Value}"
                                                       Foreground="{Binding IsAvailable, Converter={StaticResource AvailBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource Card}">
            <TextBlock Style="{StaticResource MutedText}" Text="{l:T Games_Safety}" />
        </Border>
    </StackPanel>
</UserControl>
