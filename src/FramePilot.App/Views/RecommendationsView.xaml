<UserControl x:Class="FramePilot.App.Views.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FramePilot.App.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="RecCard">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,3,12,0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Visibility="{Binding IsAuto, Converter={StaticResource BoolVis}}"
                                  AutomationProperties.Name="{l:T Rec_IncludeInPlan}" ToolTip="{l:T Rec_IncludeInPlan}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding ToggleCommand}" Content="{l:T Rec_Details}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                            <WrapPanel Margin="0,8,0,6">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                                        <Run Text="{l:T Rec_Confidence}" /><Run Text=": " /><Run Text="{Binding ConfidenceText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="{Binding Flags}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Symptom}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Rec_Evidence}" />
                        <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Body}">
                                            <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource MutedGrey}" /><Run Text="{Binding Source, Mode=OneWay}" Foreground="{StaticResource MutedGrey}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Rec_Causes}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Causes}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Rec_Action}" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Action}" Margin="0,0,0,10" />
                        <StackPanel Visibility="{Binding HasVerification, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Rec_Verify}" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Verification}" Margin="0,0,0,10" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Rec_Limits}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Limitations}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="{Binding Title}" ToolTip="{Binding Url}"
                                            Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Nav_Recommendations}" />
        <TextBlock Style="{StaticResource H1}" Text="{l:T Rec_Title}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Rec_Sub}" Margin="0,0,0,20" MaxWidth="760" HorizontalAlignment="Left" />

        <Border Style="{StaticResource Card}" Visibility="{Binding HasSnapshot, Converter={StaticResource InvBoolVis}}">
            <TextBlock Style="{StaticResource Body}" Text="{l:T Rec_NoSnapshot}" />
        </Border>
        <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                Visibility="{Binding HasSession, Converter={StaticResource InvBoolVis}}">
            <TextBlock Style="{StaticResource Body}" Text="{l:T Rec_NoSession}" />
        </Border>

        <!-- Results of the last apply -->
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Visibility="{Binding HasResults, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Apply_ResultTitle}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding ResultSummary}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold">
                                    <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Target, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Note}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding MeasureAfterCommand}" Content="{l:T Apply_MeasureAfter}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 1. Auto -->
        <TextBlock Style="{StaticResource H2}" Text="{l:T Kind_Auto}" Margin="0,8,0,4" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Kind_AutoSub}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding AutoItems}" ItemTemplate="{StaticResource RecCard}" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Rec_NoneInGroup}" Margin="0,0,0,14"
                   Visibility="{Binding AutoItems.Count, Converter={StaticResource CountVis}, ConverterParameter=inv}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24" Visibility="{Binding AutoItems.Count, Converter={StaticResource CountVis}}">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding BuildPlanCommand}" Content="{l:T Rec_ViewPlan}" />
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{l:T Rec_ProNote}"
                       Visibility="{Binding IsPro, Converter={StaticResource InvBoolVis}}" />
        </StackPanel>

        <!-- Plan preview -->
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Visibility="{Binding PlanVisible, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Plan_Title}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T Plan_Sub}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding Plan}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" Text="{Binding Target}" />
                                    <TextBlock Style="{StaticResource Body}">
                                        <Run Text="{Binding Current, Mode=OneWay}" Foreground="{StaticResource Muted}" /><Run Text="  →  " /><Run Text="{Binding Desired, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Note}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Margin="0,16,0,0" IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}" Content="{l:T Plan_RestorePoint}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="30,4,0,16" Text="{l:T Plan_RestorePointHint}" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Content="{l:T Plan_Apply}" />
                    <Button Command="{Binding ClosePlanCommand}" Content="{l:T Cancel}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. User action -->
        <TextBlock Style="{StaticResource H2}" Text="{l:T Kind_User}" Margin="0,8,0,4" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Kind_UserSub}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding UserItems}" ItemTemplate="{StaticResource RecCard}" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Rec_NoneInGroup}" Margin="0,0,0,24"
                   Visibility="{Binding UserItems.Count, Converter={StaticResource CountVis}, ConverterParameter=inv}" />

        <!-- 3. Diagnostic -->
        <TextBlock Style="{StaticResource H2}" Text="{l:T Kind_Diag}" Margin="0,8,0,4" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Kind_DiagSub}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding DiagItems}" ItemTemplate="{StaticResource RecCard}" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Rec_NoneInGroup}"
                   Visibility="{Binding DiagItems.Count, Converter={StaticResource CountVis}, ConverterParameter=inv}" />
    </StackPanel>
</UserControl>
