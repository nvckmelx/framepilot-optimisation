<UserControl x:Class="FramePilot.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FramePilot.App.Localization">
    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Nav_Recovery}" />
        <TextBlock Style="{StaticResource H1}" Text="{l:T Recovery_Title}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Recovery_Sub}" Margin="0,0,0,20" MaxWidth="760" HorizontalAlignment="Left" />

        <Border Style="{StaticResource Card}" Padding="26">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Recovery_AllTitle}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16">
                    <Run Text="{l:T Recovery_Active}" /><Run Text=": " /><Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding RollbackAllCommand}" Content="{l:T Recovery_AllButton}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" Text="{l:T Recovery_FreeNote}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" Text="{Binding LastResult}" Visibility="{Binding LastResult, Converter={StaticResource NullVis}}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Command="{Binding CheckDriftCommand}" Content="{l:T Recovery_Recheck}" Margin="0" />
                    <TextBlock Style="{StaticResource H2}" Text="{l:T Recovery_DriftTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T Recovery_DriftSub}" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Body}" Text="{l:T Recovery_NoDrift}" Visibility="{Binding HasDrift, Converter={StaticResource InvBoolVis}}" />
                <ItemsControl ItemsSource="{Binding Drift}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" Text="{Binding Target}" />
                                <TextBlock Style="{StaticResource MutedText}">
                                    <Run Text="{l:T Recovery_Applied}" /><Run Text=": " /><Run Text="{Binding Applied, Mode=OneWay}" /><Run Text=" · " /><Run Text="{l:T Recovery_Now}" /><Run Text=": " /><Run Text="{Binding Current, Mode=OneWay}" Foreground="{StaticResource Warn}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasProblems, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Recovery_ProblemsTitle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Command="{Binding RollbackCommand}" Content="{l:T Recovery_Retry}" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" Text="{Binding Target}" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding StateText}" />
                                    <TextBlock Style="{StaticResource MutedText}" Foreground="{StaticResource Warn}" Text="{Binding Error}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Recovery_StartupTitle}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding StartupReport}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{l:T Recovery_ScopeTitle}" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource MutedText}" Text="{l:T Recovery_Scope}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
