<UserControl x:Class="FramePilot.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FramePilot.App.Localization">
    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Nav_Overview}" />
        <TextBlock Style="{StaticResource H1}" Text="{Binding Headline}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Overview_Sub}" Margin="0,0,0,24" MaxWidth="760" HorizontalAlignment="Left" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Primary action card -->
            <Border Style="{StaticResource Card}" Padding="26">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Overview_GameLabel}" />
                    <WrapPanel Margin="0,0,0,10">
                        <RadioButton Style="{StaticResource Segment}" GroupName="ovgame" Content="Counter-Strike 2" IsChecked="{Binding IsCs2, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ovgame" Content="VALORANT" IsChecked="{Binding IsValorant, Mode=TwoWay}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Overview_GoalLabel}" />
                    <WrapPanel Margin="0,0,0,18">
                        <RadioButton Style="{StaticResource Segment}" GroupName="ovgoal" Content="{l:T Goal_Stable}" IsChecked="{Binding IsGoalStable, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="ovgoal" Content="{l:T Goal_Latency}" IsChecked="{Binding IsGoalLatency, Mode=TwoWay}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding GameLine}" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding GoalLine}" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding LastTestLine}" Margin="0,0,0,22" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckCommand}" Content="{l:T Overview_Check}" Padding="22,12" FontSize="15" />
                        <Button Command="{Binding MeasureCommand}" Content="{l:T Overview_Measure}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0" Text="{Binding BusyText}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0" Text="{l:T Overview_CheckNote}" />
                </StackPanel>
            </Border>

            <!-- System status -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Overview_SystemState}" />
                    <ItemsControl ItemsSource="{Binding Status}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,7,0,0"
                                             Fill="{Binding Ok, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Command="{Binding HardwareCommand}" Content="{l:T Overview_SeeHardware}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Result summary -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasSnapshot, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Overview_Result}" />
                <UniformGrid Columns="3" Margin="0,4,0,18">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Metric}" Foreground="{StaticResource Accent}" Text="{Binding AutoCount}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Kind_Auto}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Metric}" Text="{Binding UserCount}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Kind_User}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Metric}" Text="{Binding DiagCount}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{l:T Kind_Diag}" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ViewPlanCommand}" Content="{l:T Overview_ViewPlan}" />
                    <Button Command="{Binding MeasureCommand}" Content="{l:T Overview_MeasureGame}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- How it works -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Overview_HowTitle}" />
                <TextBlock Style="{StaticResource Body}" Text="{l:T Overview_How}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
