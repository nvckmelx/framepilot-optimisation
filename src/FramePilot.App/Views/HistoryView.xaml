<UserControl x:Class="FramePilot.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FramePilot.App.Localization">
    <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="{l:T Nav_History}" />
        <TextBlock Style="{StaticResource H1}" Text="{l:T History_Title}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource MutedText}" Text="{l:T History_Sub}" Margin="0,0,0,20" MaxWidth="760" HorizontalAlignment="Left" />
        <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
            <TextBlock Style="{StaticResource Body}" Text="{l:T History_Empty}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding RollbackCommand}"
                                    Content="{l:T History_Rollback}" Visibility="{Binding CanRollback, Converter={StaticResource BoolVis}}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Text="{Binding Target}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding Values}" />
                                <TextBlock Style="{StaticResource MutedText}">
                                    <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource Accent}" /><Run Text=" · " /><Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Action, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Foreground="{StaticResource Warn}" Text="{Binding Error}"
                                           Visibility="{Binding Error, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
