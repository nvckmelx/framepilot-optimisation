{
  "brand": "FRAMEPILOT",
  "version": "1.0",
  "direction": "Frame F / minimal",
  "colors": {
    "ink": "#101412",
    "paper": "#F4F6EF",
    "accent": "#CBFF4D",
    "mutedLight": "#586258",
    "mutedDark": "#AEB8AE",
    "surfaceDark": "#1B211D",
    "borderLight": "#D7DDD3",
    "borderDark": "#39413B"
  },
  "typography": {
    "family": "Arial, Helvetica, sans-serif",
    "headingWeight": 700,
    "bodyWeight": 400,
    "labelWeight": 700,
    "h1Desktop": "clamp(48px, 5.5vw, 80px)",
    "h1Mobile": "clamp(36px, 9vw, 48px)",
    "h2": "clamp(28px, 4vw, 48px)",
    "body": "16px",
    "bodyLineHeight": 1.6,
    "headingLineHeight": 1.05
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radii": {
    "control": "4px",
    "card": "8px",
    "logo": "0px"
  },
  "layout": {
    "maxWidth": "1200px",
    "desktopColumns": 12,
    "mobileColumns": 4,
    "gutter": "24px",
    "mobilePadding": "20px"
  },
  "motion": {
    "fast": "180ms",
    "normal": "280ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "maxTranslate": "8px",
    "reducedMotion": true
  }
}