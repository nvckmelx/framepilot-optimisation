    <!-- Motion: durations and KeySplines (cubic-bezier equivalents for SplineDoubleKeyFrame) -->
    <Duration x:Key="DurationInstant">0:0:0.000</Duration>
    <Duration x:Key="DurationXfast">0:0:0.090</Duration>
    <Duration x:Key="DurationFast">0:0:0.140</Duration>
    <Duration x:Key="DurationBase">0:0:0.200</Duration>
    <Duration x:Key="DurationModerate">0:0:0.280</Duration>
    <Duration x:Key="DurationSlow">0:0:0.400</Duration>
    <Duration x:Key="DurationChartEnter">0:0:0.700</Duration>
    <Duration x:Key="DurationChartUpdate">0:0:0.450</Duration>
    <Duration x:Key="DurationCounter">0:0:0.900</Duration>
    <Duration x:Key="DurationGauge">0:0:0.900</Duration>
    <Duration x:Key="DurationStagger">0:0:0.040</Duration>
    <Duration x:Key="DurationExit">0:0:0.120</Duration>
    <Duration x:Key="DurationSkeletonLoop">0:0:1.400</Duration>
    <Duration x:Key="DurationLiveSample">0:0:0.250</Duration>
    <KeySpline x:Key="EaseStandard">0.2,0 0,1</KeySpline>
    <KeySpline x:Key="EaseDecelerate">0.05,0.7 0.1,1</KeySpline>
    <KeySpline x:Key="EaseAccelerate">0.3,0 0.8,0.15</KeySpline>
    <KeySpline x:Key="EaseLinear">0,0 1,1</KeySpline>

    <!-- Reusable storyboards. Skip them when SystemParameters.ClientAreaAnimation is false (Windows 'Animation effects' off). -->
    <Storyboard x:Key="EnterFadeUp">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="0:0:0.280" Value="1" KeySpline="0.05,0.7 0.1,1" /></DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"><SplineDoubleKeyFrame KeyTime="0:0:0.280" Value="0" KeySpline="0.05,0.7 0.1,1" /></DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <!-- Chart line draw: set StrokeDashArray to the path length (in stroke-thickness units) and animate StrokeDashOffset from that length to 0. -->
    <Storyboard x:Key="ChartBarGrow">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"><SplineDoubleKeyFrame KeyTime="0:0:0.700" Value="1" KeySpline="0.05,0.7 0.1,1" /></DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Focus visual: 2px ring, 2px offset -->
    <Style x:Key="TuneFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" CornerRadius="10" BorderBrush="{StaticResource StateFocusRingBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button with animated states -->
    <Style x:Key="TunePrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ColorTextOnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="{StaticResource ControlHeightMD}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TuneFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource RadiusMD}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.Background><SolidColorBrush x:Name="BdBrush" Color="{StaticResource StateButtonPrimaryRestColor}" /></Border.Background>
                        <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color" To="{StaticResource StateButtonPrimaryHoverColor}" Duration="0:0:0.140" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="BdBrush" Storyboard.TargetProperty="Color" To="{StaticResource StateButtonPrimaryRestColor}" Duration="0:0:0.140" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BdBrush" Property="Color" Value="{StaticResource StateButtonPrimaryPressedColor}" />
                            <Setter TargetName="Scale" Property="ScaleX" Value="0.98" />
                            <Setter TargetName="Scale" Property="ScaleY" Value="0.98" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BdBrush" Property="Color" Value="{StaticResource StateButtonPrimaryDisabledBgColor}" />
                            <Setter Property="Foreground" Value="{StaticResource StateButtonPrimaryDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
